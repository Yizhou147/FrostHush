<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku api 库要求 minSdk 24，覆盖以保持本项目 minSdk 23（与 Hail 相同做法） -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api, rikka.shizuku.provider"/>

    <!-- 专注结束提醒（Android 13+ 运行时权限，低版本自动视为已获取） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 读取已安装应用列表（无运行时弹窗，能查询到列表即视为已获取） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <!-- 设备重启后自动恢复专注会话 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 专注计划精确闹钟（Android 12+ 自动授予，无需用户额外开关） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- 专注倒计时前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- 计划可靠性检查：跳转系统页申请关闭电池优化豁免 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- 计划提醒全屏弹出：设备全屏应用/锁屏时也能看到「即将开始」提醒 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <application
        android:name=".FrostHushApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrostHush"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Shizuku 授权请求页 -->
        <activity
            android:name="rikka.shizuku.ShizukuRequestActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>

        <!-- 开机 / 应用升级后恢复专注会话 + 重建计划闹钟 -->
        <receiver
            android:name=".focus.FocusBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- 专注计划闹钟（提醒/开始/结束/决策窗口超时） -->
        <receiver
            android:name=".focus.PlanAlarmReceiver"
            android:exported="false"/>

        <!-- 待启动计划决策（继续/停止） -->
        <receiver
            android:name=".focus.PlanDecisionReceiver"
            android:exported="false"/>

        <!-- 专注倒计时前台服务 -->
        <service
            android:name=".focus.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_countdown"/>
        </service>
    </application>
</manifest>
