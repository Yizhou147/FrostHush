<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件 B · 平板 1×2（高 1 格、宽 2 格，内容与手机 2×4 相同：5 个时长格 + 「设置」）
     minWidth/minHeight 与手机版保持一致（不是按 70dp 格子公式算 Pad 格数）：Pad 的格子物理尺寸
     约等于手机的 2 格，所以 110dp / 180dp 在手机上算 2 / 3 格，在 Pad 上仍落在 1 / 2 格内；
     精确格数由 API 31+ 的 targetCellWidth/Height 声明。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="170dp"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_wide"
    android:previewImage="@drawable/widget_quick_preview_wide"
    android:widgetCategory="home_screen" />
