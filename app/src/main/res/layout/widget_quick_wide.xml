<?xml version="1.0" encoding="utf-8"?>
<!-- widget_quick_wide：标题行 + 3 列 × 2 行格子，右下角为「设置」格。
     RemoteViews 不支持 Compose，也不要在低版本依赖 GridLayout（API 31 才被 RemoteViews 支持），
     故用 LinearLayout + weight 实现，全 API 可 inflate；格子内联（不用 <include>，避免 RemoteViews 兼容性风险）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_quick_bg"
    android:padding="12dp">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingBottom="6dp"
        android:textColor="@color/widget_quick_text_title"
        android:textSize="13sp"
        android:singleLine="true"
        android:maxLines="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_cell_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="13sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_cell_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="13sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_cell_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="13sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_cell_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="13sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_cell_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="13sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_cell_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_settings_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="13sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
