<?xml version="1.0" encoding="utf-8"?>
<!-- widget_quick_small_capped · 大盒子版（Pad / 被拉大时）：卡片照旧填满盒子，格子装在固定尺寸容器（152dp×100dp、顶部左对齐），
     盒子再大只多留白、格子尺寸不变。尺寸依据 Pad 实测：盒子 297×313dp（≈2×2 Pad 格），
     番茄ToDo 同尺寸盒子里的药丸约 51×31dp、内容只占卡片宽 ~50%；我们取略大一点（2 列 × 2 行，药丸约 68×46dp），
     中文与点按手感更好。由 FocusWidgetProvider 按实测尺寸切换（阈值见该文件 CAP_* 常量）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_quick_bg"
    android:padding="12dp">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingBottom="6dp"
        android:textColor="@color/widget_quick_text_title"
        android:textSize="13sp"
        android:singleLine="true"
        android:maxLines="1" />
    <LinearLayout
        android:layout_width="152dp"
        android:layout_height="100dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_cell_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="12sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_cell_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="12sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_cell_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="12sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_cell_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/widget_quick_cell_settings_bg"
            android:gravity="center"
            android:textColor="@color/widget_quick_text_primary"
            android:textSize="12sp"
            android:textFontWeight="500"
            android:singleLine="true"
            android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
